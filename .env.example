# SakuraID 环境变量示例 —— 复制为 .env 后按需修改(docker compose 会自动读取)
# systemd / PM2 等非容器部署也可参考本清单,把变量写进单元文件或 ecosystem.config.js。

# 服务端口。Docker Compose:宿主机映射端口(容器内固定 9000);Node/systemd:进程监听端口
PORT=9000

# 对外地址,同时是 OIDC issuer;通过域名或反向代理访问时必填
BASE_URL=https://sso.example.com

# 数据目录(SQLite + 签名密钥)。Docker 容器内固定为 /data;Node/systemd 部署建议 /var/lib/sakuraid
# DATA_DIR=./data

# SQLite 持久性:默认 FULL。显式选择 NORMAL 可减少提交同步开销,
# 但断电/操作系统崩溃可能丢失已提交事务(包括撤销令牌与密码变更)。仅接受该风险时修改。
# SQLITE_SYNCHRONOUS=FULL

# === TLS 直连(可选):TLS_CERT 与 TLS_KEY 同时设置后,服务自身以 HTTPS 对外并自动附加 HSTS ===
# 证书文件(fullchain)路径,容器内示例:/data/tls/fullchain.pem
# TLS_CERT=/data/tls/fullchain.pem

# 证书私钥路径,容器内示例:/data/tls/privkey.pem
# TLS_KEY=/data/tls/privkey.pem

# 可选:另起一个 HTTP 端口,把全部请求 301 跳转到 HTTPS(0 或不设置为关闭)
# TLS_REDIRECT_PORT=80

# === SMTP 找回密码邮件(可选):设置后覆盖配置向导里的值;不配置则邮件内容打到日志 ===
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=no-reply@example.com
# SMTP_PASS=change-me
# 发件人显示(可带名称)
# SMTP_FROM=SakuraID <no-reply@example.com>

# === 令牌与会话有效期(秒,可选):覆盖配置向导里的值 ===
# access token 有效期
# ACCESS_TOKEN_TTL=900
# refresh token 有效期
# REFRESH_TOKEN_TTL=2592000
# 登录会话有效期
# SESSION_TTL=1209600

# Docker Compose 拉取的镜像地址(自托管 registry 或锁定版本时修改)
# SAKURAID_IMAGE=ghcr.io/sakura-eco/sakuraid:latest
